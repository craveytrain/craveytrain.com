---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all %}{% if item.url and item.url.endsWith('/') %}
	<url><loc>{{ item.url | absoluteUrl }}</loc><lastmod>{{ item.date | htmlDateString }}</lastmod></url>
{%- endif %}{%- endfor %}
</urlset>
