---
pagination:
  data: collections.tagList
  size: 1
  alias: tag
  addAllPagesToCollections: true
layout: page
css: posts.css
eleventyComputed:
  title: '{{ tag }}'
  pageTitle: 'Tagged: {{ tag }} · craveytrain.com'
permalink: /tags/{{ tag | slugify }}/
---

<div class="posts-column">
{% set posts = collections[tag] | reverse %}
{% include "post-list-grouped.njk" %}

<div class="archive-closer">
  <a href="/tags/" class="archive-link">All Tags</a>
</div>
</div>
