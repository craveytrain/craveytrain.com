---
layout: base
css: prose.css
ogType: article
---

<article class="h-entry">
  <header class="post-header">
    <time class="post-date dt-published" datetime="{{ date | htmlDateString }}">{{ date | prettyDate }}</time>
    <h1 class="post-title p-name">{{ title }}</h1>
    {% if contentTags.length > 0 %}
    <div class="tag-links">
      {% for tag in contentTags %}
      <a class="p-category" href="/tags/{{ tag | slugify }}/">{{ tag }}</a>
      {% if not loop.last %}<span aria-hidden="true">◆</span>{% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </header>

  <div class="post-content e-content">
    {{ content | safe }}
  </div>

  {% include "partials/feedback.njk" %}

  {% set replies = mentions | webmentionsByType('in-reply-to') %}
  {% if replies.length > 0 %}
  <section class="replies-section">
    <h2 class="band-heading">Replies</h2>
    {% include "replies.njk" %}
  </section>
  {% endif %}
</article>
