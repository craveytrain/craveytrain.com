{%- if posts.length -%}
{% for group in posts | groupByYearDesc %}
	<section class="year-group">
		<div class="year-rule"><span class="year-numeral">{{ group.year }}</span></div>
		<div class="posts-for-year">
			{% for post in group.posts %}
				{% set tags = post.data.contentTags %}
				<article class="row post-row h-entry">
					<time class="date-stamp dt-published" datetime="{{ post.date | htmlDateString }}">{{ post.date.toLocaleDateString("en-US", {month: "short", day: "numeric", timeZone: "UTC"}) | upper }}</time>
					<h2 class="row-title"><a class="u-url p-name" href="{{ post.url }}">{{ post.data.title }}</a></h2>
					{%- if tags.length -%}
					<div class="row-tags">
						{%- set shown = tags | head(3) if tags.length >= 4 else tags -%}
						{% for tag in shown %}<a href="/tags/{{ tag | slugify }}/">{{ tag }}</a>{% if not loop.last %}<span class="sep" aria-hidden="true">·</span>{% endif %}{% endfor %}
						{%- if tags.length >= 4 -%}
							<span class="sep" aria-hidden="true">·</span><span class="tag-more">+{{ tags.length - 3 }}</span>
						{%- endif -%}
					</div>
					{%- endif -%}
				</article>
			{% endfor %}
		</div>
	</section>
{% endfor %}
{%- endif -%}
